# ============================================
# 🔐 BAFI Gaming - Environment Variables
# ============================================
# এই ফাইলটি একটি উদাহরণ টেমপ্লেট।
# আসল মান .env.local ফাইলে রাখুন।

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Admin Configuration
VITE_ADMIN_EMAIL=admin@example.com

# ============================================
# 📌 কীভাবে ব্যবহার করবেন:
# ============================================
# ১. .env.example কপি করে .env.local নাম দিন
# ২. নিচের মানগুলো আপনার আসল তথ্য দিয়ে বসান:
#    VITE_SUPABASE_URL    → Supabase Project URL
#    VITE_SUPABASE_PUBLISHABLE_KEY → Supabase Publishable Key
#    VITE_ADMIN_EMAIL     → আপনার Admin Email
# ৩. .env.local ফাইল কখনো Git-এ পুশ করবেন না
# ============================================